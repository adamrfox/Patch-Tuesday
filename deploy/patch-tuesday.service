[Unit]
Description=Patch Tuesday - patch management for Proxmox LXC containers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=midway
WorkingDirectory=/home/midway/patch-tuesday
ExecStart=/home/midway/patch-tuesday/.venv/bin/python -m app
Restart=on-failure
RestartSec=5
Environment=PORT=5000
Environment=TZ=America/New_York
Environment=LOG_DIR=/home/midway/patch-tuesday/data/logs
# This host's own IP (adjust to your deployment) — marks it as local so
# patches for this entry run on the host instead of over SSH. This is
# usually auto-detected, so the line is belt-and-suspenders for cases
# where hostname/IP detection misses the address.
Environment=PTU_LOCAL_HOSTS=192.168.86.190

[Install]
WantedBy=multi-user.target
